# ============================================================================
#  Tranche environment template
#
#  1. Copy this file to .env.local (git-ignored):   copy .env.example .env.local
#  2. Open it:                                        notepad .env.local
#  3. Replace every  <<< PASTE ... >>>  line with the real value, removing the
#     <<< and >>> too. No quotes, no spaces around "=".
#  Step-by-step instructions for every value are in SETUP.md.
#  Never put real keys in this file: it is committed to git. .env.local is not.
# ============================================================================

# --- 1. PostgreSQL (Neon) ----------------------------------------------------
# neon.com > your project > Connect > copy the connection string.
# Keep "?sslmode=require" at the end.
DATABASE_URL=<<< PASTE_NEON_CONNECTION_STRING_HERE >>>

# --- 2-4. PayPal sandbox app -------------------------------------------------
# developer.paypal.com > Log in to Dashboard > toggle "Sandbox"
#   > Apps & Credentials > your app (Type: Merchant) > Client ID and Secret.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=<<< PASTE_SANDBOX_CLIENT_ID_HERE >>>
PAYPAL_CLIENT_SECRET=<<< PASTE_SANDBOX_SECRET_HERE >>>
# The SAME Client ID again: the browser uses this copy for the PayPal button.
# Restart "npm run dev" after changing it.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=<<< PASTE_THE_SAME_SANDBOX_CLIENT_ID_HERE >>>

# --- 5. Gemini ---------------------------------------------------------------
# aistudio.google.com/apikey > Create API key.
GEMINI_API_KEY=<<< PASTE_GEMINI_API_KEY_HERE >>>
# gemini-3.8-flash is the default for new Google projects. gemini-1.5 is retired;
# gemini-2.5-flash only works if your Google project already used 2.5.
GEMINI_MODEL=gemini-3.8-flash
# How much Gemini thinks before answering: low | medium | high.
# low = Google's lowest-latency setting (recommended for live demos).
GEMINI_THINKING_LEVEL=low
# When GEMINI_MODEL is busy ("high demand") or too slow, these models are tried in order.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
# Switch to the next model if one hasn't answered within this many milliseconds.
# Text (contract compile, transcript audit): 40 s. Watching a YouTube video takes longer: 120 s.
# The last model in the list is never cut off. The Deal Desk uses tighter limits of its own,
# listed in src/lib/copilot/deal-desk.ts.
GEMINI_TIMEOUT_MS=40000
GEMINI_VIDEO_TIMEOUT_MS=120000

# --- 6. YouTube Data API v3 --------------------------------------------------
# console.cloud.google.com > APIs & Services > Library > "YouTube Data API v3"
#   > Enable > Credentials > + Create credentials > API key.
YOUTUBE_API_KEY=<<< PASTE_YOUTUBE_API_KEY_HERE >>>

# --- 7. Cron secret (you make this one up) -----------------------------------
# Any random string of 32+ characters. Generate one in your terminal with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=<<< PASTE_THE_RANDOM_STRING_YOU_GENERATED_HERE >>>

# --- Already set (no action needed) ------------------------------------------
# Public URL of this app (PayPal return URLs and the poll script use it).
APP_URL=http://localhost:3000
# Optional: database connection pool size.
DATABASE_POOL_MAX=10

# Spend Firewall policy
# false blocks every release (kill switch).
PAYMENTS_ENABLED=true
# Every observation a tranche relies on must be at least this confident.
MIN_CONFIDENCE=0.85
# Allowed disagreement between the app clock and database timestamps (ms).
CLOCK_DRIFT_TOLERANCE_MS=60000
# Evidence older than this cannot be used for a release (seconds).
MAX_EVIDENCE_AGE_SECONDS=900
# How often (ms) to ask PayPal again about a payout it is still processing.
PAYOUT_RECHECK_MS=15000
# Length of one contract "day" in ms. 86400000 = real days.
# For the demo video use 60000 (1 day = 1 minute). Deadlines shrink too:
# "publish within 7 days" becomes 7 minutes.
DEMO_DAY_MS=86400000
